#!name = LINE 底部标签实验
#!desc = 实验性隐藏 Shopping、新闻和 Apps。默认关闭，请逐项测试；Apps 映射未经证实。禁用后需等待 LINE 刷新配置。
#!author = lpleasure
#!homepage = https://github.com/lpleasure/line-tabs-loon
#!loon_version = 3.5.1(983)
#!system = iOS,iPadOS

[Argument]
shopping = switch,false,tag=隐藏 Shopping
news = switch,false,tag=隐藏新闻
apps = switch,false,tag=隐藏 Apps（实验）

[Script]
response if ${url} ~= /^https:\/\/legy-jp\.line-apps\.com\/S4(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/lpleasure/line-tabs-loon/main/line-tabs-plugin.js", {${shopping}, ${news}, ${apps}}) with requires_body=true, binary_body_mode=true, tag="LINE 底部标签实验"

[Mitm]
hostname = legy-jp.line-apps.com
